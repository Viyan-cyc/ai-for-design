{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "assetId",
    "assetVersion",
    "directionId",
    "templateId",
    "components",
    "interactions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.2"
    },
    "assetId": {
      "type": "string",
      "minLength": 1
    },
    "assetVersion": {
      "type": "string",
      "minLength": 1
    },
    "directionId": {
      "type": "string",
      "minLength": 1
    },
    "templateId": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "assetGaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "theme": {
      "enum": [
        "light",
        "dark"
      ]
    },
    "visualStyle": {
      "enum": [
        "enterprise-light-dark",
        "frosted-glass",
        "aurora-glass"
      ]
    },
    "handoff": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
