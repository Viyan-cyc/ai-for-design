{
  "version": "1",
  "meta": {
    "name": "empty-scene",
    "description": "空起步场景：舞台配置齐备（灯光/相机/环境），零业务节点。LLM 从检索/建模结果在此装配业务分组。"
  },
  "scene": {
    "background": "#eef0f3",
    "environment": {
      "intensity": 0.6
    },
    "fog": null
  },
  "camera": {
    "type": "PerspectiveCamera",
    "position": [
      8,
      6,
      10
    ],
    "lookAt": [
      0,
      1,
      0
    ],
    "fov": 50
  },
  "lights": [
    {
      "id": "DirectionalLight_001",
      "type": "DirectionalLight",
      "color": "#ffffff",
      "intensity": 2.2,
      "position": [
        6,
        10,
        4
      ],
      "castShadow": true,
      "shadowMapSize": 512,
      "shadowBias": -0.0005,
      "shadowCameraNear": 0.5,
      "shadowCameraFar": 200,
      "shadowCameraLeft": -15,
      "shadowCameraRight": 15,
      "shadowCameraTop": 15,
      "shadowCameraBottom": -15
    },
    {
      "id": "AmbientLight_001",
      "type": "AmbientLight",
      "color": "#8899aa",
      "intensity": 0.4
    }
  ],
  "controls": {
    "type": "OrbitControls",
    "target": [
      0,
      1,
      0
    ],
    "minDistance": 2,
    "maxDistance": 80
  },
  "renderer": {
    "toneMapping": "ACESFilmic",
    "exposure": 1,
    "shadowMap": "PCF",
    "shadowMapEnabled": false,
    "pixelRatio": 1,
    "shadowMapSize": 512,
    "antialias": false,
    "logarithmicDepthBuffer": false,
    "maxFps": 60,
    "renderMode": "demand"
  }
}
