{
  "version": "1",
  "meta": {
    "name": "starter-scene",
    "description": "模板起步场景（v3）：地面 + trees 过程化低模树 + cars 业务分组示例（状态视觉/卡片内联）+ examples 自定义 handler 演示"
  },
  "scene": {
    "background": "#0f151b",
    "environment": {
      "intensity": 0.6
    },
    "fog": null
  },
  "camera": {
    "type": "PerspectiveCamera",
    "position": [8, 6, 10],
    "lookAt": [0, 1, 0],
    "fov": 50
  },
  "lights": [
    {
      "id": "DirectionalLight_001",
      "type": "DirectionalLight",
      "color": "#ffffff",
      "intensity": 2.2,
      "position": [6, 10, 4],
      "castShadow": true,
      "shadowMapSize": 2048,
      "shadowBias": -0.0005,
      "shadowCameraNear": 0.5,
      "shadowCameraFar": 200,
      "shadowCameraLeft": -15,
      "shadowCameraRight": 15,
      "shadowCameraTop": 15,
      "shadowCameraBottom": -15
    },
    {
      "id": "AmbientLight_001",
      "type": "AmbientLight",
      "color": "#8899aa",
      "intensity": 0.4
    }
  ],
  "controls": {
    "type": "OrbitControls",
    "target": [0, 1, 0],
    "minDistance": 2,
    "maxDistance": 80
  },
  "renderer": {
    "toneMapping": "ACESFilmic",
    "exposure": 1.0,
    "shadowMap": "PCFSoft",
    "shadowMapEnabled": true,
    "maxPixelRatio": 2
  },
  "Box": [
    {
      "id": "ground",
      "position": [0, 0, 0],
      "rotation": [-1.5707963, 0, 0],
      "scale": [40, 40, 1]
    }
  ],
  "trees": [
    { "id": "tree_01", "position": [-7, 0, -5], "scale": 1.2 },
    { "id": "tree_02", "position": [-8.5, 0, 2.5], "scale": 0.9 },
    { "id": "tree_03", "position": [6.5, 0, -6], "scale": 1.1 },
    { "id": "tree_04", "position": [8, 0, 3.5], "scale": 1 },
    { "id": "tree_05", "position": [0.5, 0, -7.5], "scale": 0.8 }
  ],
  "cars": [
    {
      "id": "car_01",
      "parentId": null,
      "position": [-3, 0.5, 0],
      "rotation": [0, 0, 0],
      "scale": 1,
      "card": { "type": "example", "trigger": "always", "offset": [0, 1.4, 0] },
      "params": { "assetId": "example", "name": "巡逻车 01", "status": "normal", "speed": 1.2 }
    },
    {
      "id": "car_02",
      "parentId": null,
      "position": [0, 0.5, -2],
      "rotation": [0, 0, 0],
      "scale": 1,
      "card": { "type": "example", "trigger": "click", "offset": [0, 1.4, 0] },
      "params": { "assetId": "example", "name": "巡逻车 02", "status": "alarm", "speed": 0.6 }
    }
  ],
  "examples": [
    {
      "id": "example_01",
      "parentId": null,
      "position": [2.5, 0.5, 1.5],
      "rotation": [0, 0, 0],
      "scale": 1,
      "params": { "assetId": "example", "spin": true }
    }
  ]
}
