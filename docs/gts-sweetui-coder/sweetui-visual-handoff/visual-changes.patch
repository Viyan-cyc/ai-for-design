+  scrollBottom()
+  timer = setTimeout(async () => {
+    try {
+      const text = await getDemoReply(payload.text || '请分析附件')
+      if (id === generation) messages.value.push({ id: `a-${Date.now()}`, role: 'assistant', text })
+    } catch {
+      if (id === generation) messages.value.push({ id: `e-${Date.now()}`, role: 'assistant', text: '演示回复失败，请重试。' })
+    } finally {
+      if (id === generation) { busy.value = false; scrollBottom() }
+    }
+  }, 1800)
+}
+function stop() {
+  clearTimeout(timer); generation++; busy.value = false
+  messages.value.push({ id: `stop-${Date.now()}`, role: 'assistant', text: '已停止生成。' })
+  scrollBottom()
+}
+function focusEvidence(id) { selected.value = id; showEvidence.value = true }
