diff --git a/skills/gts-sweetui-coder/vendor/code-example/references/table-search-drawer/api/tasks.js b/skills/gts-sweetui-coder/vendor/code-example/references/table-search-drawer/api/tasks.js
new file mode 100644
index 0000000..9f73951
--- /dev/null
+++ b/skills/gts-sweetui-coder/vendor/code-example/references/table-search-drawer/api/tasks.js
@@ -0,0 +1,15 @@
+import { tasks } from './mock/tasks-data.js'
+
+export async function getTaskList({ keyword = '', type = '', dateRange = [], page = 1, pageSize = 20 } = {}) {
+  await new Promise(r => setTimeout(r, 300))
+  const kw = keyword.trim().toLowerCase()
+  const rows = tasks.filter(row => {
+    if (kw && !row.name.toLowerCase().includes(kw) && !row.assignee.includes(kw)) return false
+    if (type && row.type !== type) return false
+    if (dateRange?.[0] && row.date < dateRange[0]) return false
+    if (dateRange?.[1] && row.date > dateRange[1]) return false
+    return true
+  })
+  const start = (Math.max(1, page) - 1) * pageSize
+  return { list: rows.slice(start, start + pageSize).map(r => ({ ...r })), total: rows.length }
+}
