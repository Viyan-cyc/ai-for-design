+<script setup>
+import { ref, computed, onMounted, onUnmounted } from 'vue'
+import { SweetButton, SweetIcon, SweetDialog, SweetAlert } from '@hw-seq/sweet-ui-base'
+import WorkbenchShell from './components/foundation/workbench-shell.vue'
+import AiWorkspace from './components/ai-workspace.vue'
+import ResourceWorkspace from './components/resource-workspace.vue'
+import SessionPanel from './components/session-panel.vue'
+
+const mode = ref('ai')
+const sessionsOpen = ref(false)
+const info = ref('')
+const isDark = ref(false)
+onMounted(() => { isDark.value = (document.body.getAttribute('theme') || '').includes('dark') })
+
+// watch theme attribute
+let themeObserver = null
+onMounted(() => {
+  themeObserver = new MutationObserver(() => {
+    isDark.value = (document.body.getAttribute('theme') || '').includes('dark')
+  })
+  themeObserver.observe(document.body, { attributes: true, attributeFilter: ['theme'] })
+})
+onUnmounted(() => { themeObserver?.disconnect() })
+const tabs = ref([
+  { id: 'mail', title: '閭欢搴旂敤鍙戦€佸け璐ユ帓鏌?, status: 'done' },
+  { id: 'network', title: '鏍稿績浜ゆ崲鏈洪摼璺瘖鏂?, status: 'pending' },
+  { id: 'storage', title: '瀛樺偍瀹归噺瓒嬪娍鍒嗘瀽', status: 'idle' }
+])
+const resourceTabs = ref([{ id: 'resources', title: '璧勬簮鎬昏', status: 'done', closable: false }])
+const activeTab = ref('mail')
+const activeResource = ref('resources')
+const activeMenu = ref('monitor')
+const active = computed(() => tabs.value.find(t => t.id === activeTab.value))
+const menus = computed(() => [
+  { id: 'monitor', label: mode.value === 'ai' ? '鏅鸿兘鐩戞帶' : '璧勬簮鎬昏', icon: 'sweetui-icon-dashboard-l', tone: 'blue' },
+  { id: 'flow', label: mode.value === 'ai' ? '杩愮淮娴佺▼' : '鏈嶅姟鐩綍', icon: 'sweetui-icon-link-l', tone: 'green' },
+  { id: 'jobs', label: '浣滀笟涓績', icon: 'sweetui-icon-task-list-l', tone: 'blue' },
+  { id: 'visual', label: '鍙鍖栦腑蹇?, icon: 'sweetui-icon-indicator-l', tone: 'purple' },
+  { id: 'files', label: '鐭ヨ瘑涓庢枃妗?, icon: 'sweetui-icon-folder-opened-l', tone: 'purple' },
+  { id: 'settings', label: '绯荤粺璁剧疆', icon: 'sweetui-icon-seting-l', tone: 'blue' }
+])
+function switchMode() { sessionsOpen.value = false; activeMenu.value = 'monitor' }
+function toggleTheme() {
+  const current = document.body.getAttribute('theme') || ''
+  window.setTheme(current.includes('dark') ? 'uDesign2.2-light' : 'uDesign2.2-dark')
+}
+function closeTab(id) {
+  const list = mode.value === 'ai' ? tabs : resourceTabs
+  const current = mode.value === 'ai' ? activeTab : activeResource
+  const i = list.value.findIndex(t => t.id === id)
+  list.value = list.value.filter(t => t.id !== id)
+  if (current.value === id) current.value = list.value[Math.max(0, i - 1)]?.id || ''
+}
+function newTab() {
+  const item = { id: `workspace-${Date.now()}`, title: mode.value === 'ai' ? '鏂版帓闅滀細璇? : '璧勬簮鏌ヨ', status: 'idle' }
+  if (mode.value === 'ai') { tabs.value.push(item); activeTab.value = item.id }
+  else { resourceTabs.value.push(item); activeResource.value = item.id }
+}
+function selectMenu(id) {
+  activeMenu.value = id
+  if (id === 'monitor') return
+  const name = menus.value.find(m => m.id === id)?.label
+  info.value = `${name}涓哄彲閰嶇疆瀵艰埅鍏ュ彛銆傛湰娆¤仛鐒﹂鏋跺鐢紝璇ヤ笟鍔℃ā鍧楀皻鏈帴鍏ャ€俙
+}
+function openSession(item) {
+  if (!tabs.value.some(t => t.id === item.id)) tabs.value.push({ ...item, status: 'idle' })
+  activeTab.value = item.id
+  sessionsOpen.value = false
+}
+async function fullscreen() {
+  try {
+    if (document.fullscreenElement) await document.exitFullscreen()
+    else await document.documentElement.requestFullscreen()
+  } catch { info.value = '褰撳墠娴忚鍣ㄤ笉鏀寔椤甸潰鍏ㄥ睆锛岃浣跨敤娴忚鍣ㄥ叏灞忓姛鑳姐€? }
+}
+</script>
+<template>
+  <div class="foundation">
+    <WorkbenchShell
+      :brand="mode === 'ai' ? 'MindOps' : 'CloudOps'"
+      :workspace-name="mode === 'ai' ? '鏅鸿兘杩愮淮宸ヤ綔鍙? : '璧勬簮绠＄悊宸ヤ綔鍙?"
+      :menus="menus"
+      :tabs="mode === 'ai' ? tabs : resourceTabs"
+      :active-tab="mode === 'ai' ? activeTab : activeResource"
+      :active-menu="activeMenu"
+      @select-menu="selectMenu"
+      @select-tab="mode === 'ai' ? activeTab = $event : activeResource = $event"
+      @close-tab="closeTab"
+      @new-tab="newTab"
+      @sessions="sessionsOpen = !sessionsOpen"
+    >
+      <template #tools>
+        <div class="preview-mode">
+          <span>楠ㄦ灦棰勮</span>
+          <select v-model="mode" aria-label="鍒囨崲绀轰緥" @change="switchMode">
+            <option value="ai">AI 宸ヤ綔鍙?/option>
+            <option value="resources">鏅€氭煡璇㈤〉</option>
+          </select>
+        </div>
+        <div class="tool-group">
+          <SweetButton text aria-label="鎵撳紑鏈€杩戜細璇? @click="sessionsOpen = !sessionsOpen">
+            <SweetIcon icon-class="sweetui-icon-manage-tasks-l" :size="17" />
+          </SweetButton>
+          <SweetButton text aria-label="鏌ョ湅閫氱煡" @click="info = '褰撳墠涓虹绾块瑙堬紝娌℃湁鏂扮殑涓氬姟閫氱煡銆?">
+            <SweetIcon icon-class="sweetui-icon-message-l" :size="17" />
+          </SweetButton>
+          <SweetButton text aria-label="鍏ㄥ睆棰勮" @click="fullscreen">
+            <SweetIcon icon-class="sweetui-icon-full-screen-l" :size="17" />
+          </SweetButton>
+          <SweetButton text aria-label="鍒囨崲娣辨祬涓婚" @click="toggleTheme">
+            <SweetIcon :icon-class="isDark ? 'sweetui-icon-skin-peeler-l' : 'sweetui-icon-skin-peeler-l'" :size="17" />
+          </SweetButton>
+          <span class="avatar">杩?/span>
+        </div>
+      </template>
+
+      <SessionPanel
+        v-if="sessionsOpen"
+        :business="mode === 'resources'"
+        @close="sessionsOpen = false"
+        @open="openSession"
+        @new="newTab(); sessionsOpen = false"
+      />
+
+      <template v-if="mode === 'ai'">
+        <template v-for="tab in tabs" :key="tab.id">
+          <AiWorkspace v-show="activeTab === tab.id" :session="tab" />
+        </template>
+        <div v-if="!active" class="empty-state">
+          <SweetIcon icon-class="sweetui-icon-message-l" :size="40" />
+          <p>寮€濮嬩竴涓柊鐨勫伐浣滃尯</p>
+          <SweetButton type="primary" @click="newTab">鏂板缓浼氳瘽</SweetButton>
+        </div>
+      </template>
+      <template v-else>
+        <template v-for="tab in resourceTabs" :key="tab.id">
+          <ResourceWorkspace v-show="activeResource === tab.id" />
+        </template>
+      </template>
+    </WorkbenchShell>
+
+    <SweetDialog :model-value="!!info" title="棰勮璇存槑" width="440" draggable :close-on-click-modal="false" @update:model-value="info = ''">
+      <p>{{ info }}</p>
+      <template #footer>
+        <SweetButton type="primary" @click="info = ''">鐭ラ亾浜?/SweetButton>
+      </template>
+    </SweetDialog>
+  </div>
+</template>
+<style scoped>
+.foundation {
+  height: 100vh; overflow: hidden;
+  font-size: var(--swt-font-size-normal);
+  line-height: var(--swt-font-line-height-normal);
