+}
+.preview-mode {
+  display: flex; gap: var(--swt-space-size-8); align-items: center;
+  font-size: var(--swt-font-size-small); color: var(--swt-color-text-secondary);
+  border-right: 1px solid var(--swt-color-dividing-line-primary);
