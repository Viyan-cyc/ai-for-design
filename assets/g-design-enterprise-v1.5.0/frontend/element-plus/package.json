{
  "name": "@g-design/enterprise",
  "version": "1.5.0",
  "description": "G Design enterprise UI assets based on Element Plus 2.13.5",
  "type": "module",
  "main": "dist/g-design-enterprise.js",
  "module": "dist/g-design-enterprise.js",
  "files": [
    "dist",
    "src",
    "tokens",
    "assets",
    "licenses"
  ],
  "exports": {
    ".": {
      "import": "./dist/g-design-enterprise.js",
      "require": "./dist/g-design-enterprise.umd.cjs"
    },
    "./style.css": "./dist/g-design-enterprise.css",
    "./glass.css": "./tokens/glass.css",
    "./tokens": "./tokens/index.scss"
  },
  "scripts": {
    "dev": "vite --config vite.preview.config.ts --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build --config vite.preview.config.ts",
    "build:preview": "vue-tsc --noEmit && vite build --config vite.preview.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "build:library": "vue-tsc --noEmit && vite build"
  },
  "peerDependencies": {
    "vue": ">=3.4.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "element-plus": "2.13.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "less": "^4.9.1",
    "sass": "1.89.2",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vue": "3.5.16",
    "vue-tsc": "2.2.10"
  }
}
