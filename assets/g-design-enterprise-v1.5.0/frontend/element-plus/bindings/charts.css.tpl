/* H Design 色彩.docx 映射。原文与使用规则：source/h-design-color-spec.md、source/h-design-color-mappings.md。 */
/* 默认六色顺序与原图一致；尾部色用于超过六色的环形图/堆叠柱状图。 */
:root,
[data-chart-palette="default"] {
  --color-chart-1: {{charts-default|--color-chart-1}};
  --color-chart-2: {{charts-default|--color-chart-2}};
  --color-chart-3: {{charts-default|--color-chart-3}};
  --color-chart-4: {{charts-default|--color-chart-4}};
  --color-chart-5: {{charts-default|--color-chart-5}};
  --color-chart-6: {{charts-default|--color-chart-6}};
  --color-chart-tail: {{charts-default|--color-chart-tail}};
  --color-chart-accessible-1: {{charts-default|--color-chart-accessible-1}};
  --color-chart-accessible-2: {{charts-default|--color-chart-accessible-2}};
  --color-chart-accessible-3: {{charts-default|--color-chart-accessible-3}};
  --color-chart-accessible-4: {{charts-default|--color-chart-accessible-4}};
  --color-chart-accessible-5: {{charts-default|--color-chart-accessible-5}};
  --color-chart-accessible-6: {{charts-default|--color-chart-accessible-6}};
  --color-chart-extension-1-1: {{charts-default|--color-chart-extension-1-1}};
  --color-chart-extension-1-2: {{charts-default|--color-chart-extension-1-2}};
  --color-chart-extension-1-3: {{charts-default|--color-chart-extension-1-3}};
  --color-chart-extension-1-4: {{charts-default|--color-chart-extension-1-4}};
  --color-chart-extension-2-1: {{charts-default|--color-chart-extension-2-1}};
  --color-chart-extension-2-2: {{charts-default|--color-chart-extension-2-2}};
  --color-chart-extension-2-3: {{charts-default|--color-chart-extension-2-3}};
  --color-chart-extension-2-4: {{charts-default|--color-chart-extension-2-4}};
  --color-chart-extension-3-1: {{charts-default|--color-chart-extension-3-1}};
  --color-chart-extension-3-2: {{charts-default|--color-chart-extension-3-2}};
  --color-chart-extension-3-3: {{charts-default|--color-chart-extension-3-3}};
  --color-chart-extension-3-4: {{charts-default|--color-chart-extension-3-4}};
}
[data-chart-palette="accessible"] {
  --color-chart-1: {{charts-accessible|--color-chart-1}};
  --color-chart-2: {{charts-accessible|--color-chart-2}};
  --color-chart-3: {{charts-accessible|--color-chart-3}};
  --color-chart-4: {{charts-accessible|--color-chart-4}};
  --color-chart-5: {{charts-accessible|--color-chart-5}};
  --color-chart-6: {{charts-accessible|--color-chart-6}};
}
[data-chart-palette="extension-1"] {
  --color-chart-1: {{charts-extension-1|--color-chart-1}};
  --color-chart-2: {{charts-extension-1|--color-chart-2}};
  --color-chart-3: {{charts-extension-1|--color-chart-3}};
  --color-chart-4: {{charts-extension-1|--color-chart-4}};
  --color-chart-5: {{charts-extension-1|--color-chart-5}};
  --color-chart-6: {{charts-extension-1|--color-chart-6}};
}
[data-chart-palette="extension-2"] {
  --color-chart-1: {{charts-extension-2|--color-chart-1}};
  --color-chart-2: {{charts-extension-2|--color-chart-2}};
  --color-chart-3: {{charts-extension-2|--color-chart-3}};
  --color-chart-4: {{charts-extension-2|--color-chart-4}};
  --color-chart-5: {{charts-extension-2|--color-chart-5}};
  --color-chart-6: {{charts-extension-2|--color-chart-6}};
}
[data-chart-palette="extension-3"] {
  --color-chart-1: {{charts-extension-3|--color-chart-1}};
  --color-chart-2: {{charts-extension-3|--color-chart-2}};
  --color-chart-3: {{charts-extension-3|--color-chart-3}};
  --color-chart-4: {{charts-extension-3|--color-chart-4}};
  --color-chart-5: {{charts-extension-3|--color-chart-5}};
  --color-chart-6: {{charts-extension-3|--color-chart-6}};
}
