/* H Design 色彩.docx 映射。原文与使用规则：source/h-design-color-spec.md、source/h-design-color-mappings.md。 */
:root,
[data-theme] {
  --g-form-label-color: {{form|--g-form-label-color}};
  --g-input-bg: {{form|--g-input-bg}};
  --g-input-border: {{form|--g-input-border}};
  --g-input-focus: {{form|--g-input-focus}};
  --g-input-error: {{form|--g-input-error}};
}
