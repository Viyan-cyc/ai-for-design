/* H Design 色彩.docx 映射。原文与使用规则：source/h-design-color-spec.md、source/h-design-color-mappings.md。 */
:root,
[data-theme] {
  --g-feedback-info: {{feedback|--g-feedback-info}};
  --g-feedback-success: {{feedback|--g-feedback-success}};
  --g-feedback-warning: {{feedback|--g-feedback-warning}};
  --g-feedback-danger: {{feedback|--g-feedback-danger}};
  --g-feedback-alert: {{feedback|--g-feedback-alert}};
  --g-feedback-none: {{feedback|--g-feedback-none}};
}
