/* H Design 色彩.docx 映射。原文与使用规则：source/h-design-color-spec.md、source/h-design-color-mappings.md。 */
:root,
[data-theme] {
  --g-overlay-bg: {{overlay|--g-overlay-bg}};
  --g-overlay-mask: {{overlay|--g-overlay-mask}};
  --g-overlay-shadow: {{overlay|--g-overlay-shadow}};
  --g-overlay-radius: {{overlay|--g-overlay-radius}};
}
