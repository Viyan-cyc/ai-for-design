{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "three": [
        "node_modules/@types/three"
      ],
      "three/*": [
        "node_modules/@types/three/*"
      ],
      "gsap": [
        "node_modules/gsap"
      ]
    },
    "strictNullChecks": false
  },
  "include": [
    "src",
    "vite.config.ts",
    "../../docs/create-3d-component/component-authoring-work/n2-isolated-grid/src"
  ]
}